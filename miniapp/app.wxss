page {
  background: #f5f6f7;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.muted {
  color: #8a919f;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  background: #eef3fb;
  color: #3a66b8;
}

.tag-green {
  background: #e8f7ea;
  color: #1aad19;
}

.tag-orange {
  background: #fff3e0;
  color: #e6830c;
}

.tag-gray {
  background: #f0f1f3;
  color: #8a919f;
}

.btn {
  background: #1aad19;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
  text-align: center;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: #ffffff;
  color: #1aad19;
  border: 2rpx solid #1aad19;
}

.btn-danger {
  background: #fa5151;
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

.disclaimer {
  color: #8a919f;
  font-size: 22rpx;
  margin-top: 16rpx;
}

.empty {
  text-align: center;
  color: #8a919f;
  padding: 80rpx 0;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.divider {
  height: 1rpx;
  background: #eeeeee;
  margin: 20rpx 0;
}

.input {
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.textarea {
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  margin-bottom: 20rpx;
}
