<view class="container">
  <!-- 校园身份状态 -->
  <view class="card">
    <view class="section-head">
      <text class="section-index">01</text>
      <text class="section-label">校园身份</text>
      <view class="section-rule"></view>
    </view>
    <view class="status-row">
      <text class="muted">核验状态</text>
      <text class="tag {{verificationStatus === 'EMAIL_VERIFIED' ? 'tag-green' : 'tag-gray'}}">
        {{verificationStatus === 'EMAIL_VERIFIED' ? '已核验校园邮箱' : '未核验'}}
      </text>
    </view>
    <block wx:if="{{verificationStatus === 'EMAIL_VERIFIED'}}">
      <view class="divider"></view>
      <view class="meta-row"><text class="meta-label">已核验邮箱</text>{{verifiedEmail}}</view>
      <view class="meta-row"><text class="meta-label">核验时间</text>{{emailVerifiedAt}}</view>
    </block>
    <view class="disclaimer">校园邮箱核验仅代表邮箱属于某校园域名，不代表校方认证或身份可信。</view>
  </view>

  <!-- 邮箱核验 -->
  <view class="card">
    <view class="section-head">
      <text class="section-index">02</text>
      <text class="section-label">校园邮箱核验</text>
      <view class="section-rule"></view>
    </view>
    <view class="muted" style="margin-bottom: 20rpx;">使用校园邮箱（如 @xx.edu.cn）核验身份，核验后可覆盖为新的校园邮箱。</view>
    <view class="form-label">校园邮箱</view>
    <input class="input" placeholder="如：student@xx.edu.cn" value="{{email}}" data-field="email" bindinput="onInput" />
    <button class="btn btn-ghost btn-block" bindtap="onSendCode" loading="{{verifying}}" disabled="{{verifying}}">
      {{codeSent ? '重新发送验证码' : '发送验证码'}}
    </button>
    <block wx:if="{{codeSent}}">
      <view class="form-label" style="margin-top: 20rpx;">验证码</view>
      <input class="input" placeholder="输入邮箱收到的验证码" value="{{code}}" data-field="code" bindinput="onInput" />
      <button class="btn btn-block" bindtap="onConfirmCode" loading="{{verifying}}" disabled="{{verifying}}">确认核验</button>
    </block>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="section-head">
      <text class="section-index">03</text>
      <text class="section-label">基本信息</text>
      <view class="section-rule"></view>
    </view>

    <view class="form-label">学校</view>
    <block wx:if="{{schoolName}}">
      <view class="selected-row">
        <text class="selected-value">{{schoolName}}</text>
        <text class="self-declared-note">用户自报，未经校方认证</text>
        <text class="link-btn-inline" bindtap="onChangeSchool">更改</text>
      </view>
      <view class="form-label" style="margin-top: 24rpx;">校区（可选）</view>
      <block wx:if="{{campusName}}">
        <view class="selected-row">
          <text class="selected-value">{{campusName}}</text>
          <text class="link-btn-inline" bindtap="onClearCampus">清除</text>
        </view>
      </block>
      <view class="muted" style="margin: 8rpx 0 12rpx;">从下方已上线的校区中选择：</view>
      <view wx:if="{{campuses.length === 0}}" class="muted" style="margin-bottom: 12rpx;">该校暂无已上线的校区</view>
      <view wx:for="{{campuses}}" wx:key="id" class="option-row {{campusId === item.id ? 'option-active' : ''}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onSelectCampus">
        <text>{{item.name}}</text>
        <text wx:if="{{campusId === item.id}}" class="option-check">✓</text>
      </view>
    </block>
    <block wx:else>
      <input class="input" placeholder="搜索学校名称，例如：南方大学" value="{{schoolKeyword}}" bindinput="onSearchSchool" />
      <view wx:if="{{schoolKeyword && schools.length === 0 && !searching}}" class="muted" style="margin-bottom: 12rpx;">未找到匹配学校，换个关键词试试</view>
      <view wx:for="{{schools}}" wx:key="id" class="option-row" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onSelectSchool">
        <text>{{item.name}}</text>
      </view>
    </block>

    <button class="btn btn-block" style="margin-top: 24rpx;" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存</button>
    <view class="disclaimer">学校与校区为用户自报，未经校方认证，仅用于信息筛选与展示。</view>
  </view>
</view>
