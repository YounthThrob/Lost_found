.chat-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}

.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-row.mine {
  justify-content: flex-end;
}

.bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.bubble-mine {
  background: var(--pine);
  color: #fff;
}

.bubble-other {
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--ink);
}

.bubble-type {
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 4rpx;
}

.bubble-time {
  font-size: 20rpx;
  opacity: 0.7;
  margin-top: 6rpx;
  text-align: right;
}

.quick-bar {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: var(--card);
  flex-wrap: wrap;
  border-top: 1rpx solid var(--line);
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: var(--slate-tint);
  color: var(--slate);
  font-size: 24rpx;
}

.chip-danger {
  background: var(--danger-tint);
  color: var(--danger);
}

.input-bar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.chat-input {
  flex: 1;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.send-btn {
  background: var(--pine);
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  letter-spacing: 2rpx;
}

.send-btn::after {
  border: none;
}
