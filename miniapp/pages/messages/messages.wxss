.chat-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f7;
}

.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-row.mine {
  justify-content: flex-end;
}

.bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.bubble-mine {
  background: #1aad19;
  color: #ffffff;
}

.bubble-other {
  background: #ffffff;
  color: #1f2329;
}

.bubble-type {
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 4rpx;
}

.bubble-time {
  font-size: 20rpx;
  opacity: 0.7;
  margin-top: 6rpx;
  text-align: right;
}

.quick-bar {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: #ffffff;
  flex-wrap: wrap;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: #eef3fb;
  color: #3a66b8;
  font-size: 24rpx;
}

.chip-danger {
  background: #fdecec;
  color: #fa5151;
}

.input-bar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
}

.chat-input {
  flex: 1;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #1aad19;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
}

.send-btn::after {
  border: none;
}
