<view class="container">
  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="row-between">
      <view class="tag tag-gray">{{item.statusLabel}}</view>
      <view class="muted">{{item.timeLabel}}</view>
    </view>
    <view class="stmt">{{item.statement}}</view>
    <view class="divider"></view>
    <view class="row" style="gap: 16rpx;">
      <button class="mini-btn mini-info" data-post="{{item.postId}}" bindtap="goDetail">查看物品</button>
      <button wx:if="{{item.status === 'ACCEPTED'}}" class="mini-btn mini-ok" data-id="{{item.id}}" bindtap="goHandover">交接确认</button>
      <button class="mini-btn mini-msg" data-id="{{item.id}}" bindtap="goMessages">沟通</button>
    </view>
  </view>
  <view wx:if="{{items.length === 0}}" class="empty">暂无申请</view>
</view>
