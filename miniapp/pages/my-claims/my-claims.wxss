.stmt {
  font-size: 28rpx;
  margin: 12rpx 0;
  white-space: pre-wrap;
}

.mini-btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  margin: 0;
}

.mini-btn::after {
  border: none;
}

.mini-info {
  background: #eef3fb;
  color: #3a66b8;
}

.mini-ok {
  background: #e8f7ea;
  color: #1aad19;
}

.mini-msg {
  background: #fff3e0;
  color: #e6830c;
}
