.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 24rpx;
}

.body {
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.8;
  white-space: pre-line;
}
