<view class="container" wx:if="{{post}}">
  <view class="card">
    <swiper wx:if="{{gallery.length > 0}}" class="gallery" indicator-dots="{{gallery.length > 1}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff" circular="{{gallery.length > 1}}">
      <swiper-item wx:for="{{gallery}}" wx:key="*this">
        <image class="gallery-img" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
    <view class="row-between" style="{{gallery.length > 0 ? 'margin-top: 20rpx;' : ''}}">
      <view class="tag {{post.type === 'FOUND' ? 'tag-green' : 'tag-orange'}}">{{post.type === 'FOUND' ? '招领' : '寻物'}}</view>
      <view class="tag tag-gray">{{statusLabel}}</view>
    </view>
    <view class="title">{{post.title}}</view>
    <view class="muted" style="margin-top: 8rpx;">分类：{{post.category}}</view>
    <view class="divider"></view>
    <view class="desc">{{post.publicDescription}}</view>
    <view class="divider"></view>
    <view class="meta">
      <view class="meta-row"><text class="meta-label">学校</text>{{post.school}}</view>
      <view class="meta-row" wx:if="{{post.campus}}"><text class="meta-label">校区</text>{{post.campus}}</view>
      <view class="meta-row" wx:if="{{post.area}}"><text class="meta-label">区域</text>{{post.area}}</view>
      <view class="meta-row"><text class="meta-label">发布时间</text>{{timeLabel}}</view>
    </view>
    <view class="disclaimer">学校、校区为用户自报，未经校方认证。</view>
  </view>

  <!-- 发布者操作 -->
  <view wx:if="{{isOwner}}" class="card">
    <view class="card-title">管理</view>
    <button wx:if="{{post.status === 'DRAFT'}}" class="btn btn-block" bindtap="goEdit">编辑</button>
    <button wx:if="{{post.status === 'PUBLISHED'}}" class="btn btn-ghost btn-block" bindtap="onClose" style="margin-bottom: 16rpx;">关闭信息</button>
    <button class="btn btn-block" bindtap="goClaims">收到的认领申请</button>
  </view>

  <!-- 寻物信息：发布者查看收到的线索 -->
  <view wx:if="{{isOwner && post.type === 'LOST'}}" class="card">
    <view class="card-title">收到的线索</view>
    <view wx:for="{{clues}}" wx:key="id" class="clue-item">
      <view>{{item.content}}</view>
      <view class="row-between" style="margin-top: 8rpx;">
        <view class="muted">{{item.statusLabel}}</view>
        <view wx:if="{{item.status === 'SUBMITTED'}}" class="row">
          <button class="mini-btn mini-ok" data-id="{{item.id}}" data-decision="VALID" bindtap="decideClue">有效</button>
          <button class="mini-btn mini-no" data-id="{{item.id}}" data-decision="INVALID" bindtap="decideClue">无效</button>
        </view>
      </view>
    </view>
    <view wx:if="{{clues.length === 0}}" class="empty">暂无线索</view>
  </view>

  <!-- 非发布者操作 -->
  <view wx:if="{{!isOwner}}" class="card">
    <button wx:if="{{post.type === 'FOUND' && (post.status === 'PUBLISHED' || post.status === 'VERIFYING')}}" class="btn btn-block" bindtap="goClaimForm">申请认领</button>
    <block wx:if="{{post.type === 'LOST' && post.status === 'PUBLISHED'}}">
      <textarea class="textarea" placeholder="提供线索（仅失主可见）" value="{{clueInput}}" bindinput="onClueInput" />
      <button class="btn btn-ghost btn-block" bindtap="submitClue">提交线索</button>
    </block>
    <view style="height: 16rpx;"></view>
    <button class="btn btn-ghost btn-block" bindtap="onBookmark">{{bookmarked ? '取消收藏' : '收藏'}}</button>
  </view>

  <view class="card">
    <button wx:if="{{!isOwner}}" class="link-btn" bindtap="onBlock">拉黑发布者</button>
    <button class="link-btn danger" bindtap="openReport">举报该信息</button>
  </view>
</view>

<!-- 举报弹窗 -->
<view class="mask" wx:if="{{showReport}}">
  <view class="sheet">
    <view class="sheet-title">举报信息</view>
    <picker mode="selector" range="{{reportReasons}}" bindchange="onReportReason">
      <view class="picker">{{reportReason}}</view>
    </picker>
    <textarea class="textarea" placeholder="补充说明（可选）" value="{{reportDescription}}" bindinput="onReportDesc" />
    <view class="row" style="gap: 16rpx;">
      <button class="btn btn-ghost" style="flex: 1;" bindtap="closeReport">取消</button>
      <button class="btn" style="flex: 1;" bindtap="submitReport" loading="{{submitting}}">提交</button>
    </view>
  </view>
</view>
