.title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 16rpx 0 8rpx;
}

.desc {
  color: #1f2329;
  font-size: 28rpx;
  white-space: pre-wrap;
}

.meta-row {
  padding: 8rpx 0;
  font-size: 28rpx;
}

.meta-label {
  display: inline-block;
  width: 140rpx;
  color: #8a919f;
}

.clue-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.mini-btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  margin: 0 0 0 12rpx;
}

.mini-btn::after {
  border: none;
}

.mini-ok {
  background: #e8f7ea;
  color: #1aad19;
}

.mini-no {
  background: #fdecec;
  color: #fa5151;
}

.link-btn {
  background: transparent;
  color: #3a66b8;
  font-size: 28rpx;
  padding: 12rpx 0;
  text-align: center;
}

.link-btn::after {
  border: none;
}

.link-btn.danger {
  color: #fa5151;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  background: #ffffff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 48rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.picker {
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
