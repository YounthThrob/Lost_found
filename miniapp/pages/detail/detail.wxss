.gallery {
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--paper-2);
}

.gallery-img {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 16rpx 0 8rpx;
  letter-spacing: 2rpx;
}

.desc {
  color: var(--ink);
  font-size: 28rpx;
  white-space: pre-wrap;
}

.clue-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.clue-item:last-child {
  border-bottom: none;
}
