<view class="container">
  <view wx:for="{{items}}" wx:key="postId" class="card">
    <view class="row-between">
      <view class="item-title">{{item.post.title}}</view>
      <view class="tag {{item.inactive ? 'tag-gray' : 'tag-green'}}">{{item.inactive ? '已下架/关闭' : item.statusLabel}}</view>
    </view>
    <view class="muted">{{item.post.category}} · {{item.post.school}}</view>
    <view class="muted">收藏于 {{item.timeLabel}}</view>
    <view class="divider"></view>
    <view class="row" style="gap: 16rpx;">
      <button class="mini-btn mini-info" data-id="{{item.post.id}}" data-inactive="{{item.inactive}}" bindtap="goDetail">查看</button>
      <button class="mini-btn mini-no" data-id="{{item.post.id}}" bindtap="onUnbookmark">取消收藏</button>
    </view>
  </view>
  <view wx:if="{{items.length === 0}}" class="empty">暂无收藏</view>
</view>
