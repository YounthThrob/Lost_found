.item-title {
  font-size: 32rpx;
  font-weight: 600;
}

.mini-btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  margin: 0;
}

.mini-btn::after {
  border: none;
}

.mini-info {
  background: #eef3fb;
  color: #3a66b8;
}

.mini-no {
  background: #fdecec;
  color: #fa5151;
}
