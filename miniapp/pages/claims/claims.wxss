.stmt {
  font-size: 28rpx;
  margin: 12rpx 0;
  white-space: pre-wrap;
}

.mini-btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  margin: 0;
}

.mini-btn::after {
  border: none;
}

.mini-info {
  background: #eef3fb;
  color: #3a66b8;
}

.mini-ok {
  background: #e8f7ea;
  color: #1aad19;
}

.mini-no {
  background: #fdecec;
  color: #fa5151;
}

.mini-msg {
  background: #fff3e0;
  color: #e6830c;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  background: #ffffff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 48rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.picker {
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
