.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.img-cell {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.img-thumb {
  width: 100%;
  height: 100%;
}

.img-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(20, 17, 12, 0.6);
  color: #fff;
  font-size: 30rpx;
}

.img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--paper);
  border: 2rpx dashed var(--line-strong);
  box-sizing: border-box;
  color: var(--ink-faint);
}

.img-add-plus {
  font-size: 56rpx;
  line-height: 1;
}

.img-add-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
