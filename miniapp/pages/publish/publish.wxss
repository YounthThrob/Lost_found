.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.img-cell {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.img-thumb {
  width: 100%;
  height: 100%;
}

.img-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(20, 17, 12, 0.6);
  color: #fff;
  font-size: 30rpx;
}

.img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--paper);
  border: 2rpx dashed var(--line-strong);
  box-sizing: border-box;
  color: var(--ink-faint);
}

.img-add-plus {
  font-size: 56rpx;
  line-height: 1;
}

.img-add-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.selected-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  background: var(--pine-tint);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 8rpx;
}

.selected-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pine);
}

.self-declared-note {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.link-btn-inline {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--slate);
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
}

.option-row:last-child {
  border-bottom: none;
}

.option-active {
  background: var(--pine-tint);
  border-radius: 12rpx;
  color: var(--pine);
}

.option-check {
  color: var(--pine);
  font-weight: 700;
}
