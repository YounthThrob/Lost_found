<view class="container">
  <view class="card">
    <view class="form-label">类型</view>
    <picker mode="selector" range="{{typeLabels}}" value="{{type === 'LOST' ? 1 : 0}}" bindchange="onTypeChange">
      <view class="picker">{{typeLabel}}</view>
    </picker>

    <view class="form-label">物品分类</view>
    <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="picker">{{category}}</view>
    </picker>

    <view class="form-label">图片（可选，最多 {{maxImages}} 张）</view>
    <view class="img-grid">
      <view wx:for="{{images}}" wx:key="src" class="img-cell">
        <image class="img-thumb" src="{{item.src}}" mode="aspectFill" data-idx="{{index}}" bindtap="previewImage" />
        <view class="img-remove" data-idx="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view wx:if="{{images.length < maxImages}}" class="img-cell img-add" bindtap="chooseImages">
        <view class="img-add-plus">＋</view>
        <view class="img-add-label">添加</view>
      </view>
    </view>
    <view class="muted" style="margin-bottom: 20rpx;">支持 jpeg / png / webp，单张 ≤ 10MB</view>

    <view class="form-label">标题</view>
    <input class="input" placeholder="例如：遗失校园卡" value="{{title}}" data-field="title" bindinput="onInput" />

    <view class="form-label">公开描述</view>
    <textarea class="textarea" placeholder="描述物品特征、大致时间与地点（请勿暴露证件号、二维码、银行卡号等敏感内容）" value="{{publicDescription}}" data-field="publicDescription" bindinput="onInput" />

    <view class="form-label">学校</view>
    <block wx:if="{{schoolName}}">
      <view class="selected-row">
        <text class="selected-value">{{schoolName}}</text>
        <text class="self-declared-note">用户自报，未经校方认证</text>
        <text class="link-btn-inline" bindtap="onChangeSchool">更改</text>
      </view>
    </block>
    <block wx:else>
      <input class="input" placeholder="搜索学校名称，例如：南方大学" value="{{schoolKeyword}}" bindinput="onSearchSchool" />
      <view wx:if="{{schoolKeyword && schools.length === 0 && !searching}}" class="muted" style="margin-bottom: 12rpx;">未找到匹配学校，换个关键词试试</view>
      <view wx:for="{{schools}}" wx:key="id" class="option-row" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onSelectSchool">
        <text>{{item.name}}</text>
      </view>
    </block>

    <view class="form-label" style="margin-top: 20rpx;">校区（可选）</view>
    <block wx:if="{{schoolName}}">
      <block wx:if="{{campusName}}">
        <view class="selected-row">
          <text class="selected-value">{{campusName}}</text>
          <text class="link-btn-inline" bindtap="onClearCampus">清除</text>
        </view>
      </block>
      <view wx:if="{{campuses.length === 0}}" class="muted" style="margin-bottom: 12rpx;">该校暂无已上线的校区</view>
      <view wx:for="{{campuses}}" wx:key="id" class="option-row {{campusId === item.id ? 'option-active' : ''}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onSelectCampus">
        <text>{{item.name}}</text>
        <text wx:if="{{campusId === item.id}}" class="option-check">✓</text>
      </view>
    </block>
    <block wx:else>
      <view class="muted">请先选择学校</view>
    </block>

    <view class="form-label">模糊区域（可选）</view>
    <input class="input" placeholder="如：图书馆附近（请勿精确到宿舍房间或固定座位）" value="{{area}}" data-field="area" bindinput="onInput" />
  </view>

  <view class="disclaimer">学校、校区为用户自报，未经校方认证。请勿公开精确住址或敏感个人信息。</view>

  <button class="btn btn-ghost btn-block" bindtap="onSaveDraft" loading="{{saving}}" disabled="{{saving}}">保存草稿</button>
  <view style="height: 20rpx;"></view>
  <button class="btn btn-block" bindtap="onPublish" loading="{{saving}}" disabled="{{saving}}">提交发布</button>
</view>
