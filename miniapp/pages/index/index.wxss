page { background: #f5f2e9; }

.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  color: #162820;
  background-color: #f5f2e9;
  background-image: linear-gradient(rgba(31, 78, 59, 0.035) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(31, 78, 59, 0.035) 1rpx, transparent 1rpx);
  background-size: 31rpx 31rpx;
}

.ambient { position: absolute; pointer-events: none; }
.ambient-top { width: 310rpx; height: 310rpx; right: -124rpx; top: -96rpx; border-radius: 50%; background: rgba(231, 220, 203, 0.55); }

.brand-bar {
  position: relative;
  z-index: 1;
  height: 102rpx;
  margin: 18rpx 47rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-identity { display: flex; align-items: center; }
.brand-logo { width: 58rpx; height: 58rpx; margin-right: 16rpx; }
.brand-name { font-size: 35rpx; line-height: 42rpx; font-weight: 700; letter-spacing: 3rpx; }
.brand-en, .atlas-kicker, .section-code, .type-count, .post-time, .object-index, .continuation, .fab-label, .tab-index, .empty-index { font-family: "Menlo", "SFMono-Regular", "Consolas", monospace; }
.brand-en { margin-top: 2rpx; font-size: 11rpx; line-height: 16rpx; letter-spacing: 2rpx; color: #66756e; }

.unofficial-pill {
  height: 50rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border-radius: 25rpx;
  background: #e8e2d6;
  color: #56655e;
  font-size: 17rpx;
  white-space: nowrap;
}
.unofficial-dot { width: 10rpx; height: 10rpx; margin-right: 10rpx; border-radius: 50%; background: #e39a4a; }

.search-shell {
  position: relative;
  z-index: 1;
  height: 72rpx;
  margin: 0 47rpx 29rpx;
  padding: 0 21rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border: 1rpx solid #dcd6c9;
  border-radius: 36rpx;
  background: #ffffff;
}
.search-icon { width: 43rpx; height: 43rpx; margin-right: 13rpx; }
.search-input { flex: 1; height: 72rpx; font-size: 20rpx; color: #162820; }
.search-placeholder { color: #79857f; }
.search-divider { width: 1rpx; height: 34rpx; margin: 0 16rpx; background: #ddd7cc; }
.voice-icon { width: 34rpx; height: 34rpx; }

.atlas-card {
  position: relative;
  height: 246rpx;
  margin: 0 47rpx 35rpx;
  overflow: hidden;
  border-radius: 35rpx;
  color: #f5f2e9;
  background: linear-gradient(135deg, #245d47, #173c30);
  box-shadow: 0 13rpx 24rpx rgba(16, 37, 28, 0.09);
}
.atlas-content { position: relative; z-index: 2; padding: 37rpx 43rpx 0; }
.atlas-kicker { font-size: 12rpx; line-height: 18rpx; letter-spacing: 2rpx; color: #c4d7cd; }
.atlas-lead { margin-top: 14rpx; font-size: 21rpx; line-height: 29rpx; }
.atlas-number-row { height: 72rpx; display: flex; align-items: flex-end; }
.atlas-number { font-size: 72rpx; line-height: 72rpx; font-weight: 700; }
.atlas-number-copy { margin: 0 0 7rpx 38rpx; font-size: 24rpx; line-height: 33rpx; font-weight: 600; }
.atlas-note { margin-top: 10rpx; font-size: 15rpx; line-height: 24rpx; color: #bfd1c8; }
.atlas-action { position: absolute; right: 38rpx; bottom: 34rpx; z-index: 3; height: 36rpx; padding: 0 16rpx; display: flex; align-items: center; border: 1rpx solid rgba(245, 242, 233, 0.3); border-radius: 18rpx; background: rgba(245, 242, 233, 0.12); font-size: 14rpx; }
.atlas-arrow { margin-left: 8rpx; }

.atlas-route { position: absolute; z-index: 1; width: 920rpx; height: 130rpx; left: -28rpx; border-radius: 50%; border-top: 2rpx dashed rgba(212, 230, 220, 0.32); transform: rotate(-8deg); }
.route-muted { top: 112rpx; }
.route-active { width: 500rpx; height: 100rpx; left: 35rpx; top: 110rpx; border-top-style: solid; border-top-width: 3rpx; border-top-color: rgba(233, 176, 104, 0.82); transform: rotate(-13deg); }
.atlas-node { position: absolute; z-index: 2; width: 10rpx; height: 10rpx; border-radius: 50%; background: #f5f2e9; }
.node-a { left: 44rpx; top: 171rpx; }
.node-b { left: 253rpx; top: 139rpx; }
.node-c { left: 380rpx; top: 95rpx; }
.node-d { left: 476rpx; top: 68rpx; width: 14rpx; height: 14rpx; }
.atlas-rings { position: absolute; z-index: 1; left: 452rpx; top: 37rpx; width: 72rpx; height: 72rpx; border: 1rpx solid rgba(245, 242, 233, 0.28); border-radius: 50%; box-shadow: 0 0 0 14rpx rgba(245, 242, 233, 0.07); }

.section-title-row { height: 59rpx; margin: 0 47rpx 14rpx; display: flex; align-items: center; }
.section-title { font-size: 32rpx; line-height: 44rpx; font-weight: 700; }
.section-code { margin-left: 31rpx; font-size: 11rpx; letter-spacing: 2rpx; color: #718078; }

.type-switch { height: 69rpx; margin: 0 47rpx 27rpx; padding: 4rpx; display: flex; box-sizing: border-box; border-radius: 35rpx; background: #eae5da; }
.type-option { flex: 1; display: flex; align-items: center; padding: 0 35rpx; border-radius: 31rpx; color: #65726c; }
.type-option.active { background: #ffffff; color: #162820; box-shadow: 0 9rpx 18rpx rgba(16, 37, 28, 0.08); }
.type-dot, .badge-dot { width: 9rpx; height: 9rpx; border-radius: 50%; }
.type-dot.found, .post-badge.is-found .badge-dot { background: #2f7357; }
.type-dot.lost, .post-badge.is-lost .badge-dot { background: #e39a4a; }
.type-label { margin-left: 19rpx; font-size: 21rpx; font-weight: 600; }
.type-count { margin-left: 34rpx; font-size: 12rpx; letter-spacing: 2rpx; color: #758078; }

.category-row { height: 49rpx; margin: 0 47rpx 65rpx; display: flex; align-items: center; }
.cat-scroll { flex: 1; width: 0; white-space: nowrap; }
.cat-item { display: inline-flex; height: 40rpx; padding: 0 25rpx; margin-right: 10rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #cfc8bb; border-radius: 20rpx; color: #596760; font-size: 15rpx; background: #f5f2e9; }
.cat-item.active { color: #f7f3ea; border-color: #203e32; background: #203e32; }
.filter-icon { width: 43rpx; height: 43rpx; margin-left: 20rpx; }

.list { padding: 0 35rpx; }
.post-card { min-height: 250rpx; margin-bottom: 28rpx; padding: 44rpx 30rpx 0 16rpx; box-sizing: border-box; display: flex; border-radius: 32rpx; background: #ffffff; box-shadow: 0 13rpx 25rpx rgba(16, 37, 28, 0.08); }
.post-visual { position: relative; width: 208rpx; height: 206rpx; margin-right: 28rpx; flex-shrink: 0; overflow: hidden; border-radius: 24rpx; }
.post-image { width: 100%; height: 100%; }
.object-index { position: absolute; left: 17rpx; bottom: 10rpx; font-size: 10rpx; letter-spacing: 2rpx; color: #315343; }
.post-content { flex: 1; min-width: 0; padding-top: 2rpx; }
.post-head { height: 32rpx; display: flex; align-items: center; justify-content: space-between; }
.post-badge { height: 29rpx; padding: 0 13rpx; display: flex; align-items: center; border-radius: 15rpx; color: #2f7357; background: #dcece4; font-size: 12rpx; }
.post-badge.is-lost { color: #a55b20; background: #f6e9d8; }
.badge-dot { width: 7rpx; height: 7rpx; margin-right: 8rpx; }
.post-time { font-size: 10rpx; letter-spacing: 2rpx; color: #7b8781; }
.post-title { margin-top: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; line-height: 34rpx; font-weight: 700; }
.post-desc { margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #64716b; font-size: 16rpx; line-height: 24rpx; }
.post-rule { height: 1rpx; margin-top: 27rpx; background: #e6e1d7; }
.post-foot { height: 58rpx; display: flex; align-items: center; justify-content: space-between; }
.post-location { min-width: 0; display: flex; align-items: center; color: #64716b; font-size: 14rpx; }
.post-location text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.location-icon { width: 29rpx; height: 29rpx; margin-right: 9rpx; flex-shrink: 0; }
.self-declared { height: 30rpx; padding: 0 15rpx; margin-left: 12rpx; display: flex; align-items: center; flex-shrink: 0; border-radius: 15rpx; color: #69766f; background: #f0ede6; font-size: 11rpx; }

.empty-state { height: 260rpx; margin: 0 47rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-top: 1rpx solid #d7d1c5; color: #7d8883; }
.empty-index { font-size: 11rpx; letter-spacing: 3rpx; }
.empty-title { margin-top: 15rpx; font-size: 17rpx; }
.loading-line { width: 150rpx; height: 2rpx; background: linear-gradient(90deg, transparent, #2f7357, transparent); }
.continuation { margin: 60rpx 47rpx 108rpx; color: #7d8883; font-size: 10rpx; letter-spacing: 2rpx; }
.continuation-line { height: 1rpx; margin-bottom: 32rpx; background: #d7d1c5; }

.fab-wrap { position: fixed; right: 52rpx; bottom: calc(152rpx + env(safe-area-inset-bottom)); z-index: 30; display: flex; flex-direction: column; align-items: center; }
.fab { width: 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e69a49; box-shadow: 0 13rpx 22rpx rgba(23, 60, 48, 0.22); }
.plus-icon { width: 58rpx; height: 58rpx; }
.fab-label { margin-top: 14rpx; color: #6f7974; font-size: 9rpx; letter-spacing: 2rpx; }

.custom-tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 25; height: calc(133rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; display: flex; align-items: flex-start; justify-content: space-between; border: 1rpx solid #dad4c9; border-radius: 36rpx 36rpx 0 0; background: #faf8f3; }
.tab-item { width: 180rpx; margin: 20rpx 78rpx 0; display: flex; flex-direction: column; align-items: center; color: #7c8882; font-size: 15rpx; }
.tab-item.active { color: #28634b; font-weight: 700; }
.tab-icon-active { width: 44rpx; height: 44rpx; margin-bottom: 7rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #dcebe4; }
.tab-icon-active image { width: 34rpx; height: 34rpx; }
.tab-user-icon { width: 44rpx; height: 44rpx; margin-bottom: 7rpx; }
.tab-index { position: absolute; left: 50%; top: 70rpx; transform: translateX(-50%); color: #a0a9a4; font-size: 9rpx; letter-spacing: 2rpx; }
