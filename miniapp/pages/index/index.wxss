.page {
  padding-bottom: 160rpx;
}

/* ===== 页首 ===== */
.hero {
  padding: 24rpx 32rpx 8rpx;
}

.hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  line-height: 1.1;
}

.hero-coord {
  font-size: 22rpx;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
  font-family: "Menlo", "Consolas", monospace;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 1rpx;
}

.hero-mark {
  color: var(--amber-deep);
  font-weight: 600;
}

.hero-scale {
  height: 14rpx;
  margin: 16rpx 0 0;
  background-image: repeating-linear-gradient(
    to right,
    var(--line-strong) 0,
    var(--line-strong) 2rpx,
    transparent 2rpx,
    transparent 18rpx
  );
  opacity: 0.6;
}

/* ===== 搜索 ===== */
.search-row {
  padding: 20rpx 24rpx 8rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  padding: 8rpx 28rpx;
  height: 76rpx;
  box-sizing: border-box;
}

.search-glyph {
  color: var(--ink-faint);
  font-size: 36rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

/* ===== 类型切换 ===== */
.type-tabs {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx 4rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  border: 2rpx solid var(--line-strong);
  color: var(--ink-soft);
  background: transparent;
  transition: all 0.15s ease;
}

.type-tab.is-all.active {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--paper);
}

.type-tab.is-lost.active {
  background: var(--amber);
  border-color: var(--amber);
  color: #fff;
}

.type-tab.is-found.active {
  background: var(--pine);
  border-color: var(--pine);
  color: #fff;
}

/* ===== 分类 ===== */
.cat-scroll {
  white-space: nowrap;
  padding: 16rpx 24rpx 8rpx;
}

.cat-item {
  display: inline-block;
  padding: 10rpx 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  margin-right: 14rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.cat-item.active {
  background: var(--pine);
  border-color: var(--pine);
  color: #fff;
}

/* ===== 信息卡片 ===== */
.list {
  padding: 12rpx 24rpx 0;
}

.post-card {
  display: flex;
  gap: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(43, 39, 33, 0.04);
}

.post-media {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
}

.post-thumb {
  width: 176rpx;
  height: 176rpx;
  border-radius: 14rpx;
  background: var(--paper-2);
}

.post-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
}

.post-glyph {
  font-size: 64rpx;
  color: var(--line-strong);
}

.post-badge {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #fff;
}

.post-badge.is-found {
  background: rgba(30, 77, 59, 0.92);
}

.post-badge.is-lost {
  background: rgba(196, 112, 46, 0.94);
}

.post-count {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: rgba(20, 17, 12, 0.55);
  color: #fff;
  font-size: 20rpx;
}

.post-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.post-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-desc {
  flex: 1;
  color: var(--ink-soft);
  font-size: 26rpx;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
  overflow: hidden;
}

.post-meta-item {
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-dot {
  margin: 0 8rpx;
}

.post-school {
  flex-shrink: 1;
}

.post-time {
  margin-left: auto;
  flex-shrink: 0;
}
