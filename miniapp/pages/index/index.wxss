.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.search-btn {
  background: #1aad19;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
}

.search-btn::after {
  border: none;
}

.type-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  color: #8a919f;
  font-size: 30rpx;
}

.type-tab.active {
  color: #1aad19;
  font-weight: 600;
  border-bottom: 4rpx solid #1aad19;
}

.cat-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #ffffff;
  border-radius: 30rpx;
  margin-right: 16rpx;
  color: #5a6172;
  font-size: 26rpx;
}

.cat-item.active {
  background: #1aad19;
  color: #ffffff;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.item-desc {
  color: #5a6172;
  font-size: 26rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1aad19;
  color: #ffffff;
  font-size: 60rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(26, 173, 25, 0.4);
}
