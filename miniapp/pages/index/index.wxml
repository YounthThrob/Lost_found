<view class="container">
  <view class="search-row">
    <input class="search-input" placeholder="搜索标题或描述" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="onSearch" />
    <button class="search-btn" bindtap="onSearch">搜索</button>
  </view>

  <view class="type-tabs">
    <view class="type-tab {{activeType === 'FOUND' ? 'active' : ''}}" data-type="FOUND" bindtap="switchType">招领</view>
    <view class="type-tab {{activeType === 'LOST' ? 'active' : ''}}" data-type="LOST" bindtap="switchType">寻物</view>
  </view>

  <scroll-view scroll-x class="cat-scroll">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="cat-item {{activeCategory === item ? 'active' : ''}}"
      data-cat="{{item}}"
      bindtap="switchCategory"
    >{{item}}</view>
  </scroll-view>

  <view class="list">
    <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="row-between">
        <view class="tag {{item.type === 'FOUND' ? 'tag-green' : 'tag-orange'}}">{{item.type === 'FOUND' ? '招领' : '寻物'}}</view>
        <view class="muted">{{item.statusLabel}}</view>
      </view>
      <view class="item-title">{{item.title}}</view>
      <view class="item-desc">{{item.publicDescription}}</view>
      <view class="row-between" style="margin-top: 12rpx;">
        <view class="muted">{{item.category}} · {{item.school}}</view>
        <view class="muted">{{item.timeLabel}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && items.length === 0}}" class="empty">暂无相关信息</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <view class="fab" bindtap="goPublish">+</view>
</view>
