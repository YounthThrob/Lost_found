page { background: #f5f2e9; }

.page {
  min-height: 100vh;
  padding: 40rpx 47rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #112f25;
}

.head { margin-bottom: 34rpx; }
.head-title { font-size: 40rpx; font-weight: 700; line-height: 54rpx; }
.head-sub { margin-top: 8rpx; color: #6c8178; font-size: 15rpx; }

.card {
  padding: 44rpx 38rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(28, 48, 40, 0.07);
}

.avatar-btn {
  width: 152rpx;
  height: 152rpx;
  margin: 0 auto;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #e3eee8;
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #28634b;
  font-size: 60rpx;
  font-weight: 700;
}
.avatar-tip { margin-top: 16rpx; text-align: center; color: #819089; font-size: 13rpx; }

.field {
  margin-top: 42rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #e8e3d9;
}
.field-label { font-size: 15rpx; color: #647b71; letter-spacing: 2rpx; }
.field-input {
  margin-top: 16rpx;
  height: 60rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.save {
  margin-top: 40rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #f8f5ed;
  background: #28634b;
  font-size: 30rpx;
  font-weight: 700;
}
.save::after { border: none; }

.boundary { margin-top: 30rpx; text-align: center; color: #8c9b94; font-size: 12rpx; }
