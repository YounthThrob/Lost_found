<view class="page">
  <view class="head">
    <view class="head-title">个人资料</view>
    <view class="head-sub">昵称与头像由你设置，仅自己可见</view>
  </view>

  <view class="card">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-empty">＋</view>
    </button>
    <view class="avatar-tip">点击更换头像（微信头像能力）</view>

    <view class="field">
      <view class="field-label">昵称</view>
      <input
        class="field-input"
        type="nickname"
        value="{{nickname}}"
        placeholder="请输入昵称"
        maxlength="30"
        bindinput="onNicknameInput"
      />
    </view>
  </view>

  <button class="save" bindtap="onSave">保存</button>
  <view class="boundary">昵称与头像为用户自设，不代表任何身份或官方认证</view>
</view>
